<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Explore Voting</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f3f6fb;
            margin: 0;
            padding: 30px;
        }
        .container {
            max-width: 900px;
            margin: auto;
        }
        .poll {
            background: white;
            padding: 22px;
            margin-bottom: 18px;
            border-radius: 12px;
            box-shadow: 0 3px 12px #0000000d;
        }
        h1 { color: #17365d; }
        .category { color: #64748b; }
        .option {
            display: block;
            padding: 10px;
            margin: 8px 0;
            background: #f1f5f9;
            border-radius: 6px;
        }
        a { color: #2563eb; text-decoration: none; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Explore Voting</h1>
        <p><a href="/dashboard">← Back to Dashboard</a></p>

        <% if (votings.length === 0) { %>
            <div class="poll">
                <p>There is no active voting available at the moment..</p>
            </div>
        <% } %>

        <% votings.forEach(voting => { %>
            <div class="poll">
                <h2><%= voting.title %></h2>
                <p><%= voting.question %></p>
                <p class="category">
                    Category: <%= voting.category %>
                </p>

                <% voting.options.forEach(option => { %>
                    <div class="option">
                        <%= option.text %>
                    </div>
                <% }) %>

                <p>
                    Created: <%= new Date(voting.createdAt).toLocaleDateString() %>
                </p>
            </div>
        <% }) %>
    </div>
</body>
</html>
