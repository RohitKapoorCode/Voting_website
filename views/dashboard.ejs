<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Voting Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f4f7fb; font-family: Arial, sans-serif; }
        .navbar { background: #102b50; }
        .hero {
            background: linear-gradient(120deg, #102b50, #2563eb);
            color: white; padding: 38px; border-radius: 18px;
        }
        .feature-card {
            background: white; border: 0; border-radius: 15px;
            padding: 25px; height: 100%;
            box-shadow: 0 5px 20px #14213d0d;
        }
        .btn-primary { background: #245fe5; }
    </style>
</head>
<body>
<nav class="navbar navbar-dark px-4 py-3">
    <span class="navbar-brand fw-bold">VotePortal</span>
    <a href="/logout" class="btn btn-outline-light btn-sm">Logout</a>
</nav>

<div class="container py-5">
    <div class="hero mb-4">
        <h1 class="fw-bold">Your Voting Dashboard</h1>
        <p class="mb-0">Create Polls, Share ideas and Explore Opinions.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="feature-card">
                <h4>Create Voting</h4>
                <p class="text-secondary">Create an educational, fun or general poll.</p>
                <a href="/voting/create" class="btn btn-primary">+ Create Voting</a>
            </div>
        </div>

        <div class="col-md-6">
            <div class="feature-card">
                <h4>My Votings</h4>
                <p class="text-secondary">See the polls you have created.</p>
                <a href="/voting/mine" class="btn btn-outline-primary">View My Votings</a>
            </div>
        </div>

        <div class="col-md-6">
            <div class="feature-card">
                <h4>Explore Voting</h4>
                <p class="text-secondary">Discover polls created by users.</p>
                <a href="/voting" class="btn btn-outline-primary">Explore Polls</a>
            </div>
        </div>
    </div>
</div>
<script>
    window.addEventListener('pageshow', function (event) {
        if (event.persisted) {
            window.location.reload();
        }
    });
</script>
</body>
</html>
