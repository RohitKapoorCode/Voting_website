
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Voter Portal</title>
    <link rel="stylesheet" href="/welcome.css">
</head>
<body>

    <!-- Navbar -->
    <header class="navbar">
        <div class="logo">
            🗳️ Voter<span>Portal</span>
        </div>

        <nav class="nav-buttons">
            <a href="/login" class="login-btn">Login</a>
            <!-- <a href="Votehub.ejs" class="register-btn">Register</a> -->
        </nav>
    </header>

    <!-- Main Section -->
    <main class="hero">
        <div class="hero-content">
            <span class="tag">YOUR DEMOCRACY, YOUR FUTURE</span>

            <h1>Your Vote.<br>  
                <span>Your Voice.</span>
            </h1>

            <p>
                Welcome to the Voter Portal. Access your voter
                account, manage your details, and stay informed.
                Every vote makes a difference.
            </p>

            <div class="hero-buttons">
                <a href="register.html" class="get-started">
                    Get Started →
                </a>

                <a href="login.html" class="learn-more">
                    Voter Login
                </a>
            </div>
        </div>

        <div class="hero-image">
            <div class="circle"></div>
            <div class="vote-card">
                <div class="vote-icon">🗳️</div>
                <h2>Your Vote Matters</h2>
                <p>Be a part of the change.</p>
                <div class="vote-line"></div>
                <div class="vote-line short"></div>
                <div class="vote-status">✓ Democracy starts with you</div>
            </div>
        </div>
    </main>

    <!-- Features -->
    <section class="features">
        <div class="feature">
            <span>🔐</span>
            <h3>Secure Access</h3>
            <p>Access your account securely.</p>
        </div>

        <div class="feature">
            <span>👤</span>
            <h3>Voter Account</h3>
            <p>Manage your personal details.</p>
        </div>

        <div class="feature">
            <span>🇮🇳</span>
            <h3>Be Responsible</h3>
            <p>Stay informed and participate.</p>
        </div>
    </section>

    <footer>
        © 2026 Voter Portal. All rights reserved.
    </footer>

