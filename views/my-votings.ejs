<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>My Votings</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>

<body class="bg-light">
<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">My Votings</h2>
            <p class="text-secondary">Polls created by you</p>
        </div>

        <a href="/voting/create" class="btn btn-primary">
            + Create Voting
        </a>
    </div>

    <a href="/dashboard" class="btn btn-outline-secondary btn-sm mb-4">
        Back to Dashboard
    </a>

    <% if (created) { %>
        <div class="alert alert-success">
            Voting successfully created!
        </div>
    <% } %>

    <% if (votings.length === 0) { %>
        <div class="card card-body text-center py-5">
            <h5>No votings created yet</h5>
            <p class="text-secondary">Create your first poll to get started.</p>
        </div>
    <% } %>

    <div class="row g-3">
        <% votings.forEach(function(voting) { %>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">

                        <span class="badge bg-primary mb-2">
                            <%= voting.category %>
                        </span>

                        <h5 class="fw-bold"><%= voting.title %></h5>
                        <p><%= voting.question %></p>

                        <p class="text-secondary mb-2">Options:</p>

                        <ul>
                            <% voting.options.forEach(function(option) { %>
                                <li><%= option.text %></li>
                            <% }); %>
                        </ul>

                        <div class="alert alert-info py-2">
                            <strong>Total votes:</strong>
                            <%= voting.votes.length %>
                        </div>

                        <h6 class="fw-bold mt-3 mb-3">Vote Results</h6>

                        <% voting.options.forEach(function(option, index) { %>
                            <%
                                const optionVotes = voting.votes.filter(function(vote) {
                                    return vote.optionIndex === index;
                                }).length;

                                const percentage = voting.votes.length > 0
                                    ? Math.round((optionVotes / voting.votes.length) * 100)
                                    : 0;
                            %>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span><%= option.text %></span>
                                    <strong><%= optionVotes %> votes (<%= percentage %>%)</strong>
                                </div>

                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar bg-success"
                                        role="progressbar"
                                        style="width: <%= percentage %>%"
                                        aria-valuenow="<%= percentage %>"
                                        aria-valuemin="0"
                                        aria-valuemax="100">
                                    </div>
                                </div>
                            </div>
                        <% }); %>


                        <label class="form-label fw-semibold">
                            Share your poll
                        </label>

                        <div class="input-group mb-3">
                            <input
                                type="text"
                                class="form-control"
                                id="pollLink-<%= voting._id %>"
                                value="<%= (publicBaseUrl || 'https://voting-website-hvqz.onrender.com').replace(/\/$/, '') %>/voting/poll/<%= voting._id %>"
                                readonly
                            >

                            <button
                                type="button"
                                class="btn btn-outline-primary"
                                onclick="copyPollLink('pollLink-<%= voting._id %>')">
                                Copy Link
                            </button>
                        </div>

                        <a
                            class="btn btn-success w-100"
                            href="/voting/poll/<%= voting._id %>"
                            target="_blank">
                            Preview Public Poll
                        </a>
                        
                        <form
                            action="/voting/delete/<%= voting._id %>"
                            method="POST"
                            class="mt-2"
                            onsubmit="return confirmDeletePoll();">

                            <button type="submit" class="btn btn-outline-danger w-100">
                                Delete Poll
                            </button>
                        </form>


                    </div>
                </div>
            </div>
        <% }); %>
    </div>
</div>

<script>

    
        function confirmDeletePoll() {
            return confirm(
                'Are you sure you want to delete this poll? All votes and results will also be deleted.'
            );
        }

    async function copyPollLink(inputId) {
        const input = document.getElementById(inputId);
        const link = input.value;

        try {
            await navigator.clipboard.writeText(link);
            alert('Poll link created! You can share it now.');
        } catch (error) {
            input.select();
            input.setSelectionRange(0, 99999);

            const copied = document.execCommand('copy');

            alert(copied
                ? 'Poll link copied!'
                : 'The link wasnt copied. Select it manually and copy it.');
        }
    }
</script>

</body>
</html>
