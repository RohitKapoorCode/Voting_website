<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= voting.title %> | Voting App</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
        body {
            background: #f1f5f9;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            font-family: Arial, sans-serif;
        }

        .poll-card {
            width: 100%;
            max-width: 600px;
            background: white;
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        }

        .poll-option {
            display: block;
            border: 1px solid #dee2e6;
            border-radius: 10px;
            padding: 14px;
            margin-bottom: 12px;
            cursor: pointer;
        }

        .poll-option:hover {
            border-color: #0d6efd;
            background: #f8faff;
        }
    </style>
</head>

<body>
    <div class="poll-card">
        <h2 class="mb-2"><%= voting.title %></h2>

        <p class="text-muted"><%= voting.question %></p>

        <span class="badge bg-primary mb-4">
            <%= voting.category %>
        </span>

        <form action="/voting/poll/<%= voting._id %>/vote" method="POST">

            <% voting.options.forEach((option, index) => { %>
                <label class="poll-option">
                    <input
                        type="radio"
                        name="optionIndex"
                        value="<%= index %>"
                        required
                    >
                    <span class="ms-2"><%= option.text %></span>
                </label>
            <% }) %>

            <button type="submit" class="btn btn-primary w-100 mt-3">
                Submit Vote
            </button>
        </form>

        <p class="text-muted small mt-4 mb-0">
            Your vote helps determine the poll results.
        </p>
    </div>
</body>
</html>
