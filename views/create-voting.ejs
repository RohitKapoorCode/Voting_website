
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Create Voting </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f3f6fb; font-family: Arial, sans-serif; }
        .poll-card {
            max-width: 700px; margin: 35px auto; background: white;
            padding: 30px; border-radius: 18px;
            box-shadow: 0 8px 30px #102b5010;
        }
        .form-label { font-weight: 600; }
        .option-row { display: flex; gap: 10px; margin-bottom: 10px; }
        .submit-btn { width: 100%; padding: 12px; }
    </style>
</head>
<body>
<div class="container">
    <div class="poll-card">
        <a href="/dashboard" class="text-decoration-none">&larr; Dashboard</a>

        <h2 class="fw-bold mt-3">Create New Voting</h2>
        <p class="text-secondary">Create a poll and collect people's opinions.</p>

        <form action="/voting/create" method="POST">
            <div class="mb-3">
                <label class="form-label">Voting Title</label>
                <input type="text" name="title" class="form-control"
                       placeholder="e.g. College Election 2026" required maxlength="100">
            </div>

            <div class="mb-3">
                <label class="form-label">Your Question</label>
                <textarea name="question" class="form-control" rows="3"
                          placeholder="What do you want people to vote on?"
                          required maxlength="500"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Category</label>
                <select name="category" class="form-select" required>
                    <option value="Education">Education</option>
                    <option value="Fun">Fun</option>
                    <option value="Technology">Technology</option>
                    <option value="Sports">Sports</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Options (minimum 2)</label>
                <div id="optionsContainer">
                    <div class="option-row">
                        <input name="options[]" class="form-control"
                               placeholder="Option 1" maxlength="100" required>
                    </div>
                    <div class="option-row">
                        <input name="options[]" class="form-control"
                               placeholder="Option 2" maxlength="100" required>
                    </div>
                </div>
                <button type="button" id="addOption"
                        class="btn btn-outline-primary btn-sm mt-2">
                    + Add Option
                </button>
            </div>

            <div class="mb-4">
                <label class="form-label">End Date (optional)</label>
                <input type="datetime-local" name="expiresAt" class="form-control">
            </div>

            <button type="submit" class="btn btn-primary submit-btn">
                Create Voting
            </button>
        </form>
    </div>
</div>

<script>
    const container = document.getElementById('optionsContainer');

    document.getElementById('addOption').addEventListener('click', () => {
        if (container.children.length >= 10) {
            alert('Maximum 10 options allowed.');
            return;
        }

        const row = document.createElement('div');
        row.className = 'option-row';

        const input = document.createElement('input');
        input.name = 'options[]';
        input.className = 'form-control';
        input.placeholder = 'Option ' + (container.children.length + 1);
        input.maxLength = 100;
        input.required = true;

        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'btn btn-outline-danger';
        remove.textContent = '×';
        remove.setAttribute('aria-label', 'Remove option');
        remove.onclick = () => {
            row.remove();
            [...container.querySelectorAll('input')].forEach((el, i) => {
                el.placeholder = 'Option ' + (i + 1);
            });
        };

        row.append(input, remove);
        container.appendChild(row);
    });
</script>
</body>
</html>
